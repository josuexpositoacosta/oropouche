# Copia este archivo como application-local.properties (no se sube a Git) y rellena tus valores.
# También puedes definir estas mismas variables de entorno en lugar de usar el archivo.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=oropouchedb
DB_USERNAME=root
DB_PASSWORD=
# Generar con: openssl rand -base64 32
JWT_SECRET=
# Primer administrador (se crea al arrancar si no existe ninguno; contraseña mínima de 8 caracteres)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
